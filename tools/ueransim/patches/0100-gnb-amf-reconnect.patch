+
+void NgapTask::dropAmfUeContexts(int amfId, bool cellWillBeBarred)
+{
+    std::vector<int> ueIds;
+    for (auto &item : m_ueCtx)
+        if (item.second->associatedAmfId == amfId)
+            ueIds.push_back(item.first);
+
+    for (int ueId : ueIds)
+    {
+        m_logger->debug("Dropping UE[%d] locally, AMF[%d] is lost", ueId, amfId);
+
+        auto w1 = std::make_unique<NmGnbNgapToGtp>(NmGnbNgapToGtp::UE_CONTEXT_RELEASE);
+        w1->ueId = ueId;
+        m_base->gtpTask->push(std::move(w1));
+
+        // No NGAP message is possible. If the cell is going to be barred the UE learns about the loss from
+        // the barred MIB while RRC-connected (lower-layer failure); otherwise release the RRC connection.
+        auto w2 = std::make_unique<NmGnbNgapToRrc>(cellWillBeBarred ? NmGnbNgapToRrc::CONNECTION_FAILURE
+                                                                    : NmGnbNgapToRrc::AN_RELEASE);
+        w2->ueId = ueId;
+        m_base->rrcTask->push(std::move(w2));
+
+        deleteUeContext(ueId);
+    }
+}
+
+void NgapTask::requestSctpConnection(NgapAmfContext *amf)
+{
+    auto msg = std::make_unique<NmGnbSctp>(NmGnbSctp::CONNECTION_REQUEST);
+    msg->clientId = amf->ctxId;
+    msg->localAddress = m_base->config->ngapIp;
+    msg->localPort = 0;
+    msg->remoteAddress = amf->address;
+    msg->remotePort = amf->port;
+    msg->ppid = sctp::PayloadProtocolId::NGAP;
+    msg->associatedTask = this;
+    m_base->sctpTask->push(std::move(msg));
+}
+
+void NgapTask::handleSctpConnectionFailure(int amfId)
+{
+    auto *amf = findAmfContext(amfId);
+    if (amf == nullptr)
+        return;
+
+    amf->state = EAmfState::NOT_CONNECTED;
+    scheduleSctpReconnect(amf);
+}
+
+void NgapTask::scheduleSctpReconnect(NgapAmfContext *amf)
+{
+    amf->retryAttempts++;
+    int delay = BackoffSeconds(amf->retryAttempts, AMF_RETRY_BACKOFF_INITIAL_S, AMF_RETRY_BACKOFF_MAX_S);
+
+    // TS 38.413 §8.7.1.3: NG SETUP must not be sent before a previously received Time To Wait has expired.
+    int64_t remainingMs = amf->noSetupBeforeMs - utils::CurrentTimeMillis();
+    if (remainingMs > 0)
+        delay = std::max(delay, static_cast<int>((remainingMs + 999) / 1000));
+
+    m_logger->info("Reconnecting to AMF[%d] %s:%d in %d s (attempt %d)", amf->ctxId, amf->address.c_str(), amf->port,
+                   delay, amf->retryAttempts);
+
+    amf->retryPending = true;
+    setTimer(AMF_RETRY_TIMER_BASE_ID + amf->ctxId, static_cast<int64_t>(delay) * 1000);
+}
+
+void NgapTask::scheduleNgSetupRetry(NgapAmfContext *amf, int delaySeconds)
+{
+    m_logger->info("Retrying NG Setup with AMF[%d] in %d s", amf->ctxId, delaySeconds);
+
+    amf->retryPending = true;
+    setTimer(AMF_RETRY_TIMER_BASE_ID + amf->ctxId, static_cast<int64_t>(delaySeconds) * 1000);
+}
+
+void NgapTask::onAmfRetryTimer(int amfId)
+{
+    auto it = m_amfCtx.find(amfId);
+    if (it == m_amfCtx.end() || it->second == nullptr || !it->second->retryPending)
+        return;
+
+    auto *amf = it->second;
+    amf->retryPending = false;
+
+    if (amf->state == EAmfState::NOT_CONNECTED)
+        requestSctpConnection(amf);
+    else if (amf->state == EAmfState::WAITING_NG_SETUP)
+        sendNgSetupRequest(amfId);
 }
 
