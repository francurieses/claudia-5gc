+// Backoff delay for the n-th consecutive attempt (n >= 1): 1, 2, 4, 8, 16, then capped at 30 s.
+// Simulator choice, not a 3GPP timer.
+static int BackoffSeconds(int attempt, int initialS, int maxS)
+{
+    int delay = initialS;
+    for (int i = 1; i < attempt && delay < maxS; i++)
+        delay *= 2;
+    return delay > maxS ? maxS : delay;
+}
+
+// NG SETUP FAILURE Time To Wait IE (TS 38.413 §9.3.1.56) in seconds.
+static int TimeToWaitSeconds(ASN_NGAP_TimeToWait_t v)
+{
+    switch (v)
+    {
+    case ASN_NGAP_TimeToWait_v1s:
+        return 1;
+    case ASN_NGAP_TimeToWait_v2s:
+        return 2;
+    case ASN_NGAP_TimeToWait_v5s:
+        return 5;
+    case ASN_NGAP_TimeToWait_v10s:
+        return 10;
+    case ASN_NGAP_TimeToWait_v20s:
+        return 20;
+    case ASN_NGAP_TimeToWait_v60s:
+        return 60;
+    default:
+        return 60;
+    }
+}
