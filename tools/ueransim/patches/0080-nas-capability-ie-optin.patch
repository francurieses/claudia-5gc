+/*
+ * Parses an optional list of "octet.bit" capability bit positions (TS 24.501 Table 9.11.3.1.1 / 9.11.4.1.1
+ * numbering: octet 3 is the first value octet, bit 1 is the least significant) into value octets.
+ * Absent key -> empty string (stock bytes on the wire).
+ */
+static OctetString ParseCapabilityBits(const YAML::Node &config, const std::string &key)
+{
+    constexpr int firstOctet = 3;
+    constexpr int lastOctet = 15; // capability IEs are at most 15 octets (TS 24.501 §9.11.3.1, §9.11.4.1)
+    std::vector<int> octets(lastOctet - firstOctet + 1, 0);
+    int used = 0;
+
+    if (yaml::HasField(config, key))
+    {
+        for (auto &item : yaml::GetSequence(config, key))
+        {
+            auto text = item.as<std::string>();
+            auto dot = text.find('.');
+            if (dot == std::string::npos)
+                throw std::runtime_error(key + ": expected \"octet.bit\", got: " + text);
+            int octet = std::stoi(text.substr(0, dot));
+            int bit = std::stoi(text.substr(dot + 1));
+            if (octet < firstOctet || octet > lastOctet || bit < 1 || bit > 8)
+                throw std::runtime_error(key + ": octet must be 3..15 and bit 1..8, got: " + text);
+            octets[octet - firstOctet] |= 1 << (bit - 1);
+            used = std::max(used, octet - firstOctet + 1);
+        }
+    }
+
+    OctetString res;
+    for (int i = 0; i < used; i++)
+        res.appendOctet(octets[i]);
+    return res;
+}
