+std::string utils::Ipv6IidToToken(const OctetString &iid)
+{
+    char buffer[64] = {0};
+    if (iid.length() >= 8)
+    {
+        int g0 = (iid.getI(0) << 8) | iid.getI(1);
+        int g1 = (iid.getI(2) << 8) | iid.getI(3);
+        int g2 = (iid.getI(4) << 8) | iid.getI(5);
+        int g3 = (iid.getI(6) << 8) | iid.getI(7);
+        sprintf(buffer, "::%x:%x:%x:%x", g0, g1, g2, g3);
+    }
+    return std::string{buffer};
+}
