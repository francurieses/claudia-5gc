+
+void ConfigureTunIpv6(const char *tunName, const std::string &token)
+{
+    // acquire the configuration lock
+    const std::lock_guard<std::mutex> lock(configMutex);
+
+    std::string ifName{tunName};
+
+    SetIpv6Sysctl("all", "disable_ipv6", "0");
+    SetIpv6Sysctl(ifName, "disable_ipv6", "0");
+    // Accept Router Advertisements regardless of forwarding state, and ensure
+    // SLAAC is on (both are the kernel default; set explicitly for robustness
+    // across container base images).
+    SetIpv6Sysctl(ifName, "accept_ra", "2");
+    SetIpv6Sysctl(ifName, "autoconf", "1");
