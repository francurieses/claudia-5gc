+// 5GC Rel-17 mod: bring an interface up and set its MTU, without touching any
+// address family — reused for the IPv6-only TUN setup path (no IPv4 address
+// to assign via SIOCSIFADDR).
+static void SetInterfaceUpAndMtu(const char *ifName, int mtu)
+{
+    ifreq ifr{};
+    memset(&ifr, 0, sizeof(struct ifreq));
+    strcpy(ifr.ifr_name, ifName);
+
+    int sockFd = socket(AF_INET, SOCK_DGRAM, 0);
+
+    if (ioctl(sockFd, SIOCGIFFLAGS, &ifr) < 0)
+    {
+        close(sockFd);
+        throw LibError("ioctl(SIOCGIFFLAGS)", errno);
+    }
+
+    ifr.ifr_mtu = mtu;
+    if (ioctl(sockFd, SIOCSIFMTU, &ifr) < 0)
+    {
+        close(sockFd);
+        throw LibError("ioctl(SIOCSIFMTU)", errno);
+    }
+
+    ifr.ifr_flags |= IFF_UP | IFF_RUNNING;
+    if (ioctl(sockFd, SIOCSIFFLAGS, &ifr) < 0)
+    {
+        close(sockFd);
+        throw LibError("ioctl(SIOCSIFFLAGS)", errno);
+    }
+
+    close(sockFd);
+}
+
+// 5GC Rel-17 mod: write a value to a per-interface IPv6 sysctl knob under
+// /proc/sys/net/ipv6/conf/<ifName>/<key>. "ifName" may also be "all" to touch
+// the container-wide master switch (some kernels force IPv6 off everywhere
+// via conf/all/disable_ipv6 regardless of the per-interface value).
+static void SetIpv6Sysctl(const std::string &ifName, const std::string &key, const std::string &value)
+{
+    std::string path = "/proc/sys/net/ipv6/conf/" + ifName + "/" + key;
+    std::ofstream ofs(path);
+    if (!ofs.is_open() || !ofs.good())
+        throw LibError("Could not open '" + path + "'");
+    ofs << value;
+    if (!ofs.good())
+        throw LibError("Could not write to '" + path + "'");
+}
