+// 5GC patch 0095: apply a Session-AMBR changed by NGAP PDU Session Resource Modify. TS 38.413 §8.2.3.2, §9.3.4.3;
+// UERANSIM also polices Session-AMBR at the gNB; normatively the UPF enforces it (TS 23.501 §5.7.2.6).
+void GtpTask::handleSessionAmbrUpdate(int ueId, int psi, const AggregateMaximumBitRate &sessionAmbr)
+{
+    uint64_t sessionInd = MakeSessionResInd(ueId, psi);
+    if (!m_pduSessions.count(sessionInd))
+    {
+        m_logger->err("Session-AMBR update ignored, PDU session[%d] of UE[%d] not found", psi, ueId);
+        return;
+    }
+    m_pduSessions[sessionInd]->sessionAmbr = sessionAmbr;
+    updateAmbrForSession(sessionInd);
+}
