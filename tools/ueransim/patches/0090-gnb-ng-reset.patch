+
+// 5GC Rel-19 mod (0090): gNB-initiated NG RESET, TS 38.413 §8.7.4 / §9.2.6.1.
+// IE order: Cause (id 15, ignore), ResetType (id 88, reject).
+// Returns false (and an error text in result) if nothing could be sent.
+bool NgapTask::sendNgReset(bool resetAll, const std::vector<int64_t> &ranUeNgapIds, std::string &result)
+{
+    // amfId -> UE items; for ResetAll one empty entry per connected AMF
+    std::map<int, std::vector<std::pair<int64_t, int64_t>>> perAmf{};
+    // gNB UE context ids (ctxId) whose logical NG-connection is reset, per AMF (released after sending)
+    std::map<int, std::vector<int>> releaseIds{};
+
+    if (resetAll)
+    {
+        for (auto &amf : m_amfCtx)
+            perAmf[amf.first];
+        for (auto &uePair : m_ueCtx)
+            if (uePair.second != nullptr)
+                releaseIds[uePair.second->associatedAmfId].push_back(uePair.second->ctxId);
+    }
+    else
+    {
+        for (int64_t ranId : ranUeNgapIds)
+        {
+            auto *ue = findUeByRanId(ranId);
+            if (ue == nullptr)
+            {
+                result = "UE not found with RAN UE NGAP ID " + std::to_string(ranId);
+                return false;
+            }
+            perAmf[ue->associatedAmfId].emplace_back(ue->amfUeNgapId, ue->ranUeNgapId);
+            releaseIds[ue->associatedAmfId].push_back(ue->ctxId);
+        }
+    }
+
+    if (perAmf.empty())
+    {
+        result = "No AMF to send NG RESET to";
+        return false;
+    }
+
+    int sent = 0;
+    for (auto &entry : perAmf)
+    {
+        auto ieCause = asn::New<ASN_NGAP_NGResetIEs>();
+        ieCause->id = ASN_NGAP_ProtocolIE_ID_id_Cause;
+        ieCause->criticality = ASN_NGAP_Criticality_ignore;
+        ieCause->value.present = ASN_NGAP_NGResetIEs__value_PR_Cause;
+        ngap_utils::ToCauseAsn_Ref(NgapCause::RadioNetwork_unspecified, ieCause->value.choice.Cause);
+
+        auto ieType = asn::New<ASN_NGAP_NGResetIEs>();
+        ieType->id = ASN_NGAP_ProtocolIE_ID_id_ResetType;
+        ieType->criticality = ASN_NGAP_Criticality_reject;
+        ieType->value.present = ASN_NGAP_NGResetIEs__value_PR_ResetType;
+        if (resetAll)
+        {
+            ieType->value.choice.ResetType.present = ASN_NGAP_ResetType_PR_nG_Interface;
+            ieType->value.choice.ResetType.choice.nG_Interface = ASN_NGAP_ResetAll_reset_all;
+        }
+        else
+        {
+            ieType->value.choice.ResetType.present = ASN_NGAP_ResetType_PR_partOfNG_Interface;
+            auto *listPtr = asn::New<ASN_NGAP_UE_associatedLogicalNG_connectionList>();
+            ieType->value.choice.ResetType.choice.partOfNG_Interface = listPtr;
+            auto &list = *listPtr;
+            for (auto &ids : entry.second)
+            {
+                auto *item = asn::New<ASN_NGAP_UE_associatedLogicalNG_connectionItem>();
+                if (ids.first > 0)
+                {
+                    item->aMF_UE_NGAP_ID = asn::New<ASN_NGAP_AMF_UE_NGAP_ID_t>();
+                    asn::SetSigned64(ids.first, *item->aMF_UE_NGAP_ID);
+                }
+                item->rAN_UE_NGAP_ID = asn::New<ASN_NGAP_RAN_UE_NGAP_ID_t>();
+                *item->rAN_UE_NGAP_ID = ids.second;
+                asn::SequenceAdd(list, item);
+            }
+        }
+
+        m_logger->info("Sending NG RESET to AMF[%d] (%s, %d UE(s))", entry.first,
+                       resetAll ? "reset-all" : "part-of-NG-interface", (int)entry.second.size());
+
+        auto *pdu = asn::ngap::NewMessagePdu<ASN_NGAP_NGReset>({ieCause, ieType});
+        sendNgapNonUe(entry.first, pdu);
+        sent++;
+
+        // TS 38.413 §8.7.4.2.2: the NG-RAN node releases the resources of the reset UE-associated
+        // logical NG-connections. Same local release as UE CONTEXT RELEASE COMMAND (RRC release towards
+        // the UE + GTP context + NGAP context), but without a UE CONTEXT RELEASE COMPLETE: the NG RESET
+        // itself replaces it. The UE goes RRC-IDLE and re-attaches via Service Request.
+        for (int ueCtxId : releaseIds[entry.first])
+        {
+            auto w1 = std::make_unique<NmGnbNgapToRrc>(NmGnbNgapToRrc::AN_RELEASE);
+            w1->ueId = ueCtxId;
+            m_base->rrcTask->push(std::move(w1));
+
+            auto w2 = std::make_unique<NmGnbNgapToGtp>(NmGnbNgapToGtp::UE_CONTEXT_RELEASE);
+            w2->ueId = ueCtxId;
+            m_base->gtpTask->push(std::move(w2));
+
+            deleteUeContext(ueCtxId);
+        }
+    }
+
+    result = "NG RESET sent to " + std::to_string(sent) + " AMF(s)";
+    return true;
 }
 
+// 5GC Rel-19 mod (0090): log the NG RESET ACKNOWLEDGE (TS 38.413 §8.7.4.2). The local UE contexts were
+// already released when the NG RESET was sent (see sendNgReset); nothing blocks on the answer.
+void NgapTask::receiveNgResetAcknowledge(int amfId, ASN_NGAP_NGResetAcknowledge *msg)
+{
+    int items = 0;
+    auto *ie = asn::ngap::GetProtocolIe(msg, ASN_NGAP_ProtocolIE_ID_id_UE_associatedLogicalNG_connectionList);
+    if (ie)
+        items = ie->UE_associatedLogicalNG_connectionList.list.count;
+
+    m_logger->info("NG RESET ACKNOWLEDGE received from AMF[%d], UE-associated logical NG-connection list size: %d",
+                   amfId, items);
+}
