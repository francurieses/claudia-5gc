# MCP server -- host-mode stdio configuration for local clients (e.g. Claude Code).
#
# Copy this file to mcp/config/local.yaml (gitignored) and set the absolute paths
# of your PKI files (generated by `make pki`).
#
# Use it when the client launches the binary directly over stdio (no OAuth, unlike
# the remote SSE transport) on the HOST, outside the Docker network. Every upstream
# points at a port published by docker-compose.yml, so container names (nrf, amf,
# mgmt-portal, ...) are never resolved. Needs the core up (`make up`) and, for
# logs, traces and metrics, the observability profile (`make up-obs`).

transport: stdio

# Operator mode exposes mutating and disruptive tools (the latter need confirm:true).
# Use read-only for look-but-don't-touch sessions; lab adds admin tools.
access_mode: operator
allow_service_control: false

# Upstreams via published host ports.
nrf_addr: "https://localhost:8000"          # NRF SBI, mTLS
amf_addr: "http://localhost:9002"           # AMF management API, plain HTTP
smf_addr: "https://localhost:8004"          # SMF SBI + management API, mTLS
pcf_addr: "https://localhost:8006"          # PCF SBI, mTLS
udm_addr: "https://localhost:8003"          # UDM SBI, mTLS
bsf_addr: "https://localhost:8010"          # BSF SBI, mTLS (cert has DNS:localhost)
nef_addr: "https://localhost:8011"          # NEF SBI, mTLS + NRF bearer token (af_qos_session_*)
smsf_addr: "https://localhost:8009"         # SMSF SBI, mTLS (sms_send_mt)
portal_addr: "http://localhost:8080"        # mgmt-portal API, plain HTTP
loki_addr: "http://localhost:3100"          # observability profile
jaeger_addr: "http://localhost:16686"       # observability profile
prometheus_addr: "http://localhost:9090"    # observability profile

prometheus:
  addr: ""                                   # empty = use prometheus_addr above
  query_timeout_sec: 5

# Prometheus reports each NF's metrics address with its container name (smf:9105).
# That name does not resolve on the host. This replaces the host part with a
# reachable one and keeps the port (every NF publishes its metrics port 91xx).
# core_health and nf_log_level use it. Env: MCP_METRICS_HOST_OVERRIDE.
metrics_host_override: "localhost"

# TLS material for the SBI upstreams (NRF, SMF, PCF, UDM enforce mTLS). The NF server
# certificates must list localhost in their SANs (`make pki` does).
# Set these to the absolute path of your pki/ directory.
ca_file: "/path/to/your/repo/pki/ca.crt"
client_cert_file: "/path/to/your/repo/pki/mcp.crt"
client_key_file: "/path/to/your/repo/pki/mcp.key"

guardrails:
  min_interval_ms: 2000      # minimum gap between two confirmed disruptive calls
  max_result_bytes: 262144   # 256 KiB cap on any single tool result
  audit_size: 256
