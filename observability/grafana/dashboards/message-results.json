{
  "title": "5GC — Message Results (Success / Failure)",
  "uid": "5gc-message-results",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["5gc", "nas", "sbi", "ngap"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "NAS Messages (N1 — AMF)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "NAS Message Rate (all types)",
      "description": "Rate of NAS messages processed by the AMF, by message type and direction.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (message_type, direction) (rate(fivegc_nas_messages_total{nf=\"AMF\"}[1m]) * 60)",
          "legendFormat": "{{message_type}} {{direction}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "opm",
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "NAS Success vs Failure Rate",
      "description": "NAS messages by result (OK vs FAILURE) aggregated across all types.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(fivegc_nas_messages_total{nf=\"AMF\",result=\"OK\"}[1m])) * 60",
          "legendFormat": "Success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(fivegc_nas_messages_total{nf=\"AMF\",result=\"FAILURE\"}[1m])) * 60",
          "legendFormat": "Failure",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "opm",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Success" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Failure" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 }
    },
    {
      "id": 4,
      "type": "table",
      "title": "NAS Message Totals by Type",
      "description": "Cumulative NAS message counters by type and direction.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (message_type, direction, result) (fivegc_nas_messages_total{nf=\"AMF\"})",
          "legendFormat": "{{message_type}} {{direction}} {{result}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "sortBy": [{ "displayName": "Value", "desc": true }]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 }
    },
    {
      "id": 5,
      "type": "row",
      "title": "SBI Requests (HTTP/2 — all NFs)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "SBI Request Rate by NF",
      "description": "SBI HTTP/2 request rate per NF, any status code.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (nf) (rate(fivegc_sbi_requests_total[1m])) * 60",
          "legendFormat": "{{nf}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "opm",
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "SBI Success (2xx) vs Error (4xx/5xx) Rate",
      "description": "SBI requests by HTTP status class across all NFs.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(fivegc_sbi_requests_total{status_code=\"2xx\"}[1m])) * 60",
          "legendFormat": "2xx Success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(fivegc_sbi_requests_total{status_code=\"4xx\"}[1m])) * 60",
          "legendFormat": "4xx Client Error",
          "refId": "B"
        },
        {
          "expr": "sum(rate(fivegc_sbi_requests_total{status_code=\"5xx\"}[1m])) * 60",
          "legendFormat": "5xx Server Error",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "opm",
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "2xx Success" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "4xx Client Error" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "5xx Server Error" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 }
    },
    {
      "id": 8,
      "type": "heatmap",
      "title": "SBI Request Latency Distribution",
      "description": "Heatmap of SBI handler latency buckets (all NFs combined).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (le) (rate(fivegc_sbi_request_duration_seconds_bucket[1m]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": { "unit": "s", "decimals": 3 }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 26 }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "SBI Latency P95 per NF",
      "description": "95th-percentile SBI request duration per NF. Computed from the fivegc_sbi_request_duration_seconds histogram.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (nf, le)(rate(fivegc_sbi_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{nf}} P95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 5 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 34 }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "SBI Latency P99 per NF",
      "description": "99th-percentile SBI request duration per NF — tail latency indicator.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (nf, le)(rate(fivegc_sbi_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{nf}} P99",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 34 }
    },
    {
      "id": 9,
      "type": "row",
      "title": "3GPP Procedures",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 }
    },
    {
      "id": 10,
      "type": "piechart",
      "title": "Procedure Results Distribution",
      "description": "Pie chart of all procedure outcomes (OK / REJECT / FAILURE) across all NFs.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (result) (fivegc_procedure_total)",
          "legendFormat": "{{result}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "OK" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "REJECT" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "FAILURE" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "pieType": "donut",
        "legend": { "displayMode": "table", "placement": "right" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 43 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Procedure Success Rate Over Time",
      "description": "Ratio of OK procedures to total procedures per NF.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (nf, procedure) (rate(fivegc_procedure_total{result=\"OK\"}[5m])) / sum by (nf, procedure) (rate(fivegc_procedure_total[5m]))",
          "legendFormat": "{{nf}} {{procedure}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          },
          "custom": { "lineWidth": 2 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 43 }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Distributed Traces (Jaeger)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 51 }
    },
    {
      "id": 13,
      "type": "traces",
      "title": "Recent Traces — InitialRegistration",
      "description": "Live trace list for the InitialRegistration span from Jaeger. Click a trace to open the flame graph.",
      "datasource": { "type": "jaeger", "uid": "jaeger" },
      "targets": [
        {
          "query": "InitialRegistration/Phase1",
          "queryType": "search",
          "refId": "A",
          "service": "AMF"
        }
      ],
      "options": {
        "dedupStrategy": "none"
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 52 }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "NetworkTriggeredServiceRequest UP Activation by Result",
      "description": "Paged PDU session UP re-activation outcome in the AMF on Service Request (OK = added to ICS list, REJECT = excluded by UE PDU session status, FAILURE = unknown session or SMF activation failed). TS 23.502 §4.2.3.3.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (result) (rate(fivegc_procedure_total{nf=\"AMF\",procedure=\"NetworkTriggeredServiceRequestUPActivation\"}[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        },
        {
          "expr": "sum by (result) (rate(fivegc_procedure_total{nf=\"AMF\",procedure=\"NetworkTriggeredServiceRequest\"}[5m]))",
          "legendFormat": "paging {{result}}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } } },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 62 }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Handover SMF Leg (UpdateSMContext) by Procedure and Result",
      "description": "AMF per-PDU-session Nsmf_PDUSession_UpdateSMContext leg during handover: XnHandoverSMFUpdate (path switch), XnHandoverSMFSetupFail, XnHandoverSMFDeactivate (unlisted sessions), N2HandoverSMFPreparing (HANDOVER REQUIRED, PREPARING), N2HandoverSMFPrepare (HANDOVER REQUEST ACKNOWLEDGE, PREPARED), N2HandoverSMFResAllocFail (target-failed PSIs), N2HandoverSMFComplete (HANDOVER NOTIFY, COMPLETED). TS 23.502 §4.9.1.2.2 steps 2-7, §4.9.1.3.2 steps 3-12, §4.9.1.3.3.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (procedure, result) (rate(fivegc_procedure_total{nf=\"AMF\",procedure=~\"XnHandoverSMF.*|N2HandoverSMF.*\"}[5m]))",
          "legendFormat": "{{procedure}} {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } } },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 70 }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "PFCP Association Setup (SMF-UPF) by Result",
      "description": "SMF-initiated PFCP Association Setup towards the UPF. TS 29.244 §6.2.6.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(fivegc_procedure_total{nf=\"SMF\",procedure=\"PfcpAssociationSetup\"}[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 78
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "PFCP Heartbeat Failures (lost transactions)",
      "description": "PfcpHeartbeat FAILURE per lost Heartbeat transaction (T1/N1 exhausted). TS 29.244 §6.2.2.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(fivegc_procedure_total{nf=\"SMF\",procedure=\"PfcpHeartbeat\",result=\"FAILURE\"}[5m]))",
          "legendFormat": "heartbeat failures",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 78
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "PFCP Node-Level Recovery: detections and local-release fallbacks",
      "description": "OK = peer restart/failure detection events; FAILURE = sessions released locally (AMF release failed or release guard expired). TS 23.502 §4.4.1.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(fivegc_procedure_total{nf=\"SMF\",procedure=\"PfcpNodeLevelRecovery\"}[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 86
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "UDR Slice/DNN Session-AMBR Config (PUT/DELETE) by Result",
      "description": "SliceSessionAmbrConfig on the non-3GPP /nudr-internal/v1/slice-dnn-qos endpoints. OK = 2xx; REJECT = 4xx; FAILURE = 5xx. TS 23.501 §5.7.2.6.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (result) (rate(fivegc_procedure_total{nf=\"UDR\",procedure=\"SliceSessionAmbrConfig\"}[5m]))",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 94
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Handover DL Path Switch (SMF-UPF N4) N2 / Xn by Result",
      "description": "SMF PFCP Session Modification Update FAR (FORW to target gNB TEID) at N2 hoState COMPLETED (N2HandoverDLSwitch) and synchronous Xn path switch (XnHandoverDLSwitch). OK / REJECT (precondition) / FAILURE (N4 error or timeout). TS 23.502 §4.9.1.3.3, §4.9.1.2.2; TS 29.244 §7.5.4.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (procedure, result) (rate(fivegc_procedure_total{nf=\"SMF\",procedure=~\"N2HandoverDLSwitch|XnHandoverDLSwitch\"}[5m]))",
          "legendFormat": "{{procedure}} {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } } },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 102 }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Handover Target-Failed PDU Sessions: Deactivate / Release by Result",
      "description": "SMF action on PDU sessions the target NG-RAN failed to set up: HandoverTargetFailedDeactivate (UP deactivation via N4) or HandoverTargetFailedRelease (full release). TS 23.502 §4.9.1.3.3.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (procedure, result) (rate(fivegc_procedure_total{nf=\"SMF\",procedure=~\"HandoverTargetFailedDeactivate|HandoverTargetFailedRelease\"}[5m]))",
          "legendFormat": "{{procedure}} {{result}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2 } } },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 102 }
    }
  ]
}
