      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (role, reason) (increase(fivegc_sepp_n32_tls_reject_total{role=~\"$sepp\"}[5m]))",
          "legendFormat": "{{role}} {{reason}}",
          "refId": "A"
        }
      ]
