+package claudia
+
+import (
+	"github.com/free5gc/nas/ie"
+	log "github.com/sirupsen/logrus"
+
+	claudianas "github.com/francurieses/claudia-5gc/shared/nas"
+)
+
+// Rel19CapabilityBits are the 5GMM capability bits (TS 24.501 §9.11.3.1, Table 9.11.3.1.1) that the
+// rel19 profile sets on top of the legacy N3 data / LPP / HO attach / S1 mode set. They are limited to
+// "the UE can receive and ignore this network-provided information" bits: PacketRusher implements no
+// behaviour behind them, it only decodes and logs the matching Registration Accept IEs.
+//
+//	Rel-18: LADN-DS (LADN per DNN and S-NSSAI), NSR (network slice replacement), PNS (partial
+//	        network slice), TempNS (S-NSSAI time validity), SLVI (S-NSSAI location validity),
+//	        NSUC (network slice usage control)
+//	Rel-19: ATUC (access technology utilization control)
+func Rel19CapabilityBits() claudianas.FiveGMMCapability {
+	return claudianas.FiveGMMCapability{
+		S1Mode: true, HOAttach: true, LPP: true, // N3DataNotSupported=false: N3 data supported
+		LADNDS: true, NSR: true, PNS: true, TempNS: true, SLVI: true, NSUC: true,
+		ATUC: true,
+	}
+}
+
+// Capability5GMM returns the 5GMM capability IE of the Registration Request. rel17 returns exactly the
+// legacy PacketRusher value {N3 data, LPP, HO attach, S1 mode} (1 octet); rel19 returns the encoding
+// of Rel19CapabilityBits through the shared/nas codec (octets 3..11).
+func Capability5GMM() *ie.Capability5GMM {
+	if !IsRel19() {
+		return &ie.Capability5GMM{Length: 1, N3Data: true, LPP: true, HOAttach: true, S1Mode: true}
+	}
+	c := Rel19CapabilityBits()
+	raw, err := claudianas.Encode5GMMCapability(&c)
+	if err != nil || len(raw) == 0 {
+		log.Warnf("[UE][NAS][rel19] 5GMM capability encode failed (err=%v, %d octets); falling back to the rel17 capability", err, len(raw))
+		return &ie.Capability5GMM{Length: 1, N3Data: true, LPP: true, HOAttach: true, S1Mode: true}
+	}
+	return &ie.Capability5GMM{Length: len(raw), Raw: raw}
+}
