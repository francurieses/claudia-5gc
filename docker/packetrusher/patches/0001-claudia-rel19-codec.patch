+++ b/internal/claudia/nasobserve.go
@@ -0,0 +1,124 @@
+package claudia
+
+import (
+	"fmt"
+	"strings"
+
+	log "github.com/sirupsen/logrus"
+
+	claudianas "github.com/francurieses/claudia-5gc/shared/nas"
+)
+
+// gmmHeaderLen is the length of the plain 5GMM header (EPD, security header type, message type).
+const gmmHeaderLen = 3
+
+// regAcceptMsgType is the Registration Accept message type (TS 24.501 §8.2.7, Table 9.7.1).
+const regAcceptMsgType = 0x42
+
+// IEInfo describes one optional IE found in a downlink NAS message.
+type IEInfo struct {
+	IEI        byte
+	Name       string // "" when the IEI is not in the shared/nas table
+	Introduced string // release the IE was introduced in ("" when unknown)
+	Len        int    // value length in octets (0 for type 1/2 IEs)
+	Known      bool
+}
+
+// String renders the IE as "0x68 Extended rejected NSSAI (Rel-17, 5 octets)".
+func (i IEInfo) String() string {
+	if !i.Known {
+		return fmt.Sprintf("0x%02X unknown (%d octets)", i.IEI, i.Len)
+	}
+	return fmt.Sprintf("0x%02X %s (%s, %d octets)", i.IEI, i.Name, i.Introduced, i.Len)
+}
+
+// ScanRegistrationAcceptIEs walks the optional IEs of a plain Registration Accept (EPD 0x7E, SHT 0,
+// type 0x42) using the shared/nas IE table. Unknown IEIs are skipped with the TS 24.007 §11.2.4 rule
+// (high bit set: 1 octet; otherwise TLV) instead of aborting, which is how a UE must treat a Rel-19
+// IE it does not know (TS 24.501 §7.6.1). It returns the IEs in wire order.
+func ScanRegistrationAcceptIEs(plain []byte) ([]IEInfo, error) {
+	if len(plain) < gmmHeaderLen+2 || plain[2] != regAcceptMsgType {
+		return nil, fmt.Errorf("claudia: not a Registration Accept")
+	}
+	body := plain[gmmHeaderLen:]
+	// Mandatory 5GS registration result: LV.
+	off := 1 + int(body[0])
+	if off > len(body) {
+		return nil, fmt.Errorf("claudia: 5GS registration result length %d overruns the message (%d octets)", body[0], len(body)-1)
+	}
+	return scanIEs(body, off, func(iei byte) (claudianas.IEDef, bool) {
+		return claudianas.LookupIE(claudianas.IEMsgRegistrationAccept, iei)
+	})
+}
+
+// scanIEs walks the optional IEs of body from off using lookup for the IE definitions. It stops with
+// an error on a truncated, overrunning or zero-progress (malformed) IE.
+func scanIEs(body []byte, off int, lookup func(byte) (claudianas.IEDef, bool)) ([]IEInfo, error) {
+	var out []IEInfo
+	for off < len(body) {
+		iei := body[off]
+		info := IEInfo{IEI: iei}
+		def, known := lookup(iei)
+		var end int
+		switch {
+		case known && (def.Format == claudianas.IEFormatTV1 || def.Format == claudianas.IEFormatT), !known && iei&0x80 != 0:
+			end = off + 1
+		case known && def.Format == claudianas.IEFormatTV:
+			end = off + def.Len
+			info.Len = def.Len - 1
+		case known && def.Format == claudianas.IEFormatTLVE:
+			if off+3 > len(body) {
+				return out, fmt.Errorf("claudia: IE 0x%02X truncated", iei)
+			}
+			end = off + 3 + int(body[off+1])<<8 + int(body[off+2])
+			info.Len = end - off - 3
+		default: // TLV (known or unknown)
+			if off+2 > len(body) {
+				return out, fmt.Errorf("claudia: IE 0x%02X truncated", iei)
+			}
+			end = off + 2 + int(body[off+1])
+			info.Len = end - off - 2
+		}
+		if end <= off {
+			return out, fmt.Errorf("claudia: IE 0x%02X malformed (zero length, no progress at offset %d)", iei, off)
+		}
+		if end > len(body) {
+			return out, fmt.Errorf("claudia: IE 0x%02X overruns the message (%d > %d)", iei, end, len(body))
+		}
+		if known {
+			info.Known, info.Name, info.Introduced = true, def.Name, def.Introduced.String()
+		}
+		out = append(out, info)
+		off = end
+	}
+	return out, nil
+}
+
+// ObservePlainNAS is installed as the NAS codec's plaintext observer. In the rel17 profile it does
+// nothing. In rel19 it logs the IEs of a downlink Registration Accept and the decode result of the
+// shared/nas codec; it never alters or drops the message.
+func ObservePlainNAS(plain []byte) {
+	defer func() {
+		if r := recover(); r != nil {
+			log.Errorf("[UE][NAS][rel19] observer recovered from decoder panic: %v", r)
+		}
+	}()
+	if !IsRel19() || len(plain) < gmmHeaderLen+2 || plain[0] != 0x7E || plain[1]&0x0F != 0 || plain[2] != regAcceptMsgType {
+		return
+	}
+	ies, err := ScanRegistrationAcceptIEs(plain)
+	var names []string
+	for _, i := range ies {
+		names = append(names, i.String())
+	}
+	if err != nil {
+		log.Warnf("[UE][NAS][rel19] Registration Accept IE scan: %v", err)
+	}
+	log.Infof("[UE][NAS][rel19] Registration Accept IEs: [%s]", strings.Join(names, "; "))
+	if ra, derr := claudianas.DecodeRegistrationAccept(plain[gmmHeaderLen:]); derr != nil {
+		log.Warnf("[UE][NAS][rel19] shared/nas could not decode Registration Accept: %v", derr)
+	} else {
+		log.Infof("[UE][NAS][rel19] Registration Accept decoded: result=0x%02X guti=%t allowed_nssai=%t ext_rejected_nssai=%t",
+			ra.RegistrationResult, ra.FiveGGUTI != nil, ra.AllowedNSSAI != nil, ra.ExtendedRejectedNSSAI != nil)
+	}
+}
diff --git a/internal/claudia/ngapobserve.go b/internal/claudia/ngapobserve.go
new file mode 100644
index 0000000..4918e44
--- /dev/null
+++ b/internal/claudia/ngapobserve.go
@@ -0,0 +1,51 @@
+package claudia
+
+import (
+	log "github.com/sirupsen/logrus"
+
+	"github.com/francurieses/claudia-5gc/shared/ngap"
+	"github.com/francurieses/claudia-5gc/shared/ngap/ngapType"
+)
+
+// NGAPKind names the NGAP-PDU alternative and procedure code of a decoded PDU.
+type NGAPKind struct {
+	Choice        string // initiatingMessage | successfulOutcome | unsuccessfulOutcome
+	ProcedureCode int64
+}
+
+// DescribeNGAP decodes an NGAP PDU with the 5GC shared/ngap codec (TS 38.413 V19.x ASN.1) and reports
+// its alternative and procedure code. It accepts Rel-18/19 extensions the legacy codec rejects.
+func DescribeNGAP(payload []byte) (NGAPKind, error) {
+	pdu, err := ngap.Decoder(payload)
+	if err != nil {
+		return NGAPKind{}, err
+	}
+	switch pdu.Present {
+	case ngapType.NGAPPDUPresentInitiatingMessage:
+		return NGAPKind{"initiatingMessage", pdu.InitiatingMessage.ProcedureCode.Value}, nil
+	case ngapType.NGAPPDUPresentSuccessfulOutcome:
+		return NGAPKind{"successfulOutcome", pdu.SuccessfulOutcome.ProcedureCode.Value}, nil
+	case ngapType.NGAPPDUPresentUnsuccessfulOutcome:
+		return NGAPKind{"unsuccessfulOutcome", pdu.UnsuccessfulOutcome.ProcedureCode.Value}, nil
+	}
+	return NGAPKind{}, nil
+}
+
+// ObserveNGAP logs every downlink NGAP PDU decoded by the shared/ngap codec in the rel19 profile. It
+// never alters or drops the message; rel17 does nothing.
+func ObserveNGAP(payload []byte) {
+	defer func() {
+		if r := recover(); r != nil {
+			log.Errorf("[GNB][NGAP][rel19] observer recovered from decoder panic: %v", r)
+		}
+	}()
+	if !IsRel19() {
+		return
+	}
+	k, err := DescribeNGAP(payload)
+	if err != nil {
+		log.Warnf("[GNB][NGAP][rel19] shared/ngap could not decode DL PDU: %v", err)
+		return
+	}
+	log.Infof("[GNB][NGAP][rel19] DL %s procedureCode=%d (shared/ngap TS 38.413 V19)", k.Choice, k.ProcedureCode)
+}
diff --git a/internal/claudia/pduset.go b/internal/claudia/pduset.go
new file mode 100644
index 0000000..ce4a604
--- /dev/null
+++ b/internal/claudia/pduset.go
@@ -0,0 +1,131 @@
+package claudia
+
+import (
+	"encoding/binary"
+	"fmt"
+
+	log "github.com/sirupsen/logrus"
+)
+
+// GTP-U constants for the PDU Set Information Container (TS 29.281 V19.2.0 §5.2.1 Figure 5.2.1-3, §5.2.2.8;
+// content layout TS 38.415 V19.1.0 §6.5.2.1, same wire reference as the claudia-5gc UPF
+// nf/upf/internal/gtpu/dl_header.go).
+const (
+	// ExtHdrPDUSetInfo is the Next Extension Header Type of the PDU Set Information Container (0x04).
+	ExtHdrPDUSetInfo = 0x04
+	// ExtHdrPDUSession is the Next Extension Header Type of the PDU Session Container (0x85).
+	ExtHdrPDUSession = 0x85
+	// gtpuMinHdr is the mandatory GTP-U header; the E flag adds seq(2)+N-PDU(1)+next-ext(1).
+	gtpuMinHdr = 8
+	// gtpuOptHdr is the optional 4-octet part present when any of E/S/PN is set.
+	gtpuOptHdr = 4
+	// gtpuMsgTypeGPDU is the G-PDU message type (TS 29.281 §6.1, Table 6.1-1).
+	gtpuMsgTypeGPDU = 0xFF
+	gtpuFlagE       = 0x04
+	gtpuFlagS       = 0x02
+	gtpuFlagPN      = 0x01
+)
+
+// PDUSetInfo is the decoded DL PDU SET INFORMATION (TS 38.415 §6.5.2.1, §6.5.3).
+type PDUSetInfo struct {
+	EDB, EPDU bool
+	QFI       uint8
+	PSI       uint8
+	PSSN      uint16
+	PSN       uint8
+	HasPSSize bool
+	PSSize    uint32
+}
+
+// ParsePDUSetInfo extracts the PDU Set Information Container from a G-PDU (GTP-U message type 0xFF,
+// TS 29.281 §5.1). It walks the extension header chain; found=false (and no error) when the packet
+// has none, so legacy G-PDUs pass untouched. A non-G-PDU message type or a GTP length field that
+// overruns the packet is an error; octets beyond the length field are ignored.
+func ParsePDUSetInfo(pkt []byte) (info PDUSetInfo, found bool, err error) {
+	if len(pkt) < gtpuMinHdr {
+		return info, false, fmt.Errorf("claudia: GTP-U packet too short (%d)", len(pkt))
+	}
+	if pkt[1] != gtpuMsgTypeGPDU {
+		return info, false, fmt.Errorf("claudia: GTP-U message type 0x%02X is not a G-PDU (0xFF)", pkt[1])
+	}
+	// Length (octets 3-4) counts the octets after the mandatory 8-octet header (TS 29.281 §5.1).
+	total := gtpuMinHdr + int(binary.BigEndian.Uint16(pkt[2:4]))
+	if total > len(pkt) {
+		return info, false, fmt.Errorf("claudia: GTP-U length field %d overruns the packet (%d octets)", total-gtpuMinHdr, len(pkt)-gtpuMinHdr)
+	}
+	pkt = pkt[:total]
+	flags := pkt[0]
+	if flags&(gtpuFlagE) == 0 {
+		return info, false, nil
+	}
+	if len(pkt) < gtpuMinHdr+gtpuOptHdr {
+		return info, false, fmt.Errorf("claudia: GTP-U optional header truncated")
+	}
+	next := pkt[gtpuMinHdr+3]
+	off := gtpuMinHdr + gtpuOptHdr
+	for next != 0 {
+		if off >= len(pkt) {
+			return info, false, fmt.Errorf("claudia: GTP-U extension header chain truncated")
+		}
+		l := int(pkt[off]) * 4 // length in 4-octet units, includes length and next-type octets
+		if l < 4 || off+l > len(pkt) {
+			return info, false, fmt.Errorf("claudia: GTP-U extension header 0x%02X bad length %d", next, l)
+		}
+		if next == ExtHdrPDUSetInfo {
+			info, err = decodePDUSetContent(pkt[off+1 : off+l-1])
+			return info, err == nil, err
+		}
+		next = pkt[off+l-1]
+		off += l
+	}
+	return info, false, nil
+}
+
+// decodePDUSetContent decodes the content (without length octet and trailing next-type octet).
+func decodePDUSetContent(c []byte) (PDUSetInfo, error) {
+	var p PDUSetInfo
+	if len(c) < 5 {
+		return p, fmt.Errorf("claudia: PDU Set Information content too short (%d)", len(c))
+	}
+	if t := c[0] >> 4; t != 0 {
+		return p, fmt.Errorf("claudia: PDU Set Information PDU type %d, want 0 (DL PDU SET INFORMATION)", t)
+	}
+	p.EDB = c[0]&(1<<3) != 0
+	p.EPDU = c[0]&(1<<2) != 0
+	p.HasPSSize = c[0]&(1<<1) != 0
+	p.QFI = c[1] >> 2
+	p.PSSN = binary.BigEndian.Uint16([]byte{c[1] & 0x03, c[2]})
+	p.PSI = c[3] & 0x0F
+	p.PSN = c[4]
+	if p.HasPSSize {
+		if len(c) < 8 {
+			return p, fmt.Errorf("claudia: PDU Set Information PSSize truncated")
+		}
+		p.PSSize = uint32(c[5])<<16 | uint32(c[6])<<8 | uint32(c[7])
+	}
+	return p, nil
+}
+
+// ObserveGTPU logs the PDU Set fields of a downlink G-PDU in the rel19 profile (log only; the packet
+// is never dropped). rel17 does nothing.
+//
+// NOTE: nothing in PacketRusher calls ObserveGTPU. The live data plane is the kernel gtp5g module, which
+// terminates GTP-U in the kernel, so user space never sees the packets and there is no live hook. This is
+// a library function (unit-tested) for user-space GTP-U consumers, tests and tooling only.
+func ObserveGTPU(pkt []byte) {
+	if !IsRel19() {
+		return
+	}
+	defer func() {
+		if r := recover(); r != nil {
+			log.Errorf("[GNB][GTPU][rel19] observer recovered from panic: %v", r)
+		}
+	}()
+	p, found, err := ParsePDUSetInfo(pkt)
+	switch {
+	case err != nil:
+		log.Warnf("[GNB][GTPU][rel19] PDU Set Information: %v", err)
+	case found:
+		log.Infof("[GNB][GTPU][rel19] DL PDU Set: qfi=%d pssn=%d psn=%d psi=%d epdu=%t edb=%t pssize=%d", p.QFI, p.PSSN, p.PSN, p.PSI, p.EPDU, p.EDB, p.PSSize)
+	}
+}
diff --git a/internal/claudia/release.go b/internal/claudia/release.go
new file mode 100644
index 0000000..02ee3a8
--- /dev/null
+++ b/internal/claudia/release.go
@@ -0,0 +1,51 @@
+// Package claudia holds the opt-in claudia-5gc Rel-18/19 behaviour of PacketRusher (modified
+// Apache-2.0 PacketRusher, see docker/packetrusher/patches/README.md in the claudia-5gc repository).
+//
+// The default release is "rel17": nothing in this package changes what the UE/gNB sends or how it
+// handles downlink data. "rel19" (flag --release rel19) advertises Rel-18/19 5GMM capability bits
+// and decodes Rel-18/19 downlink NAS IEs, NGAP PDUs and GTP-U PDU Set information with the 5GC
+// shared codecs, logging what it sees.
+package claudia
+
+import (
+	"fmt"
+	"strings"
+	"sync/atomic"
+)
+
+// Release is the 3GPP release profile of the simulator.
+type Release string
+
+const (
+	// Rel17 is the default profile: byte-identical legacy behaviour.
+	Rel17 Release = "rel17"
+	// Rel19 enables Rel-18/19 capability bits and Rel-18/19 decoding (log only).
+	Rel19 Release = "rel19"
+)
+
+var current atomic.Value // Release
+
+// ParseRelease validates a --release value ("" selects rel17).
+func ParseRelease(s string) (Release, error) {
+	switch Release(strings.ToLower(strings.TrimSpace(s))) {
+	case "", Rel17:
+		return Rel17, nil
+	case Rel19:
+		return Rel19, nil
+	}
+	return Rel17, fmt.Errorf("unknown --release %q (want rel17 or rel19)", s)
+}
+
+// SetRelease selects the profile for the whole process.
+func SetRelease(r Release) { current.Store(r) }
+
+// CurrentRelease returns the selected profile (rel17 until SetRelease is called).
+func CurrentRelease() Release {
+	if r, ok := current.Load().(Release); ok {
+		return r
+	}
+	return Rel17
+}
+
+// IsRel19 reports whether the rel19 profile is active.
+func IsRel19() bool { return CurrentRelease() == Rel19 }
