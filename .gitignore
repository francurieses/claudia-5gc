# Binaries
**/bin/
**/*.test
**/*.out
coverage.out
# Root-level build output (compiled NF binaries must never be committed)
/amf
/pcf
/smf
/upf

# Node tooling
node_modules/

# PKI — private keys are never committed
pki/*.key
pki/*.csr
pki/*.srl
pki/*.cnf
# ca.crt is public and needed to verify NF connections
!pki/ca.crt

# Local environment files — only the example is committed
.env
.env.*
!.env.example

# PCAPs
pcaps/
.claude/skills/3gpp-pcap-validator/.venv/
__pycache__/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Docker local overrides
docker-compose.override.yml

# Agentic development — session state (ephemeral, do not commit)
dev/SESSION_LOG.md
.tmp/
# OpenCode: track agents + config; ignore deps and the bundled ui-ux-pro-max skill data
.opencode/node_modules/
.opencode/agent/.agents/
.opencode/agent/.claude/


# UERANSIM dev fork (throwaway source tree — the patch set is the committed artifact)
tools/ueransim/.fork/
graphify-out/

# 3GPP OpenAPI: YAMLs are fetched reference (make sync-openapi), never committed; only the
# directory README is tracked. Generated Go code is not committed either.
specs/3gpp-openapi/*/
specs/3gpp-openapi/*.yaml
specs/3gpp-openapi/UPSTREAM-README.md
**/generated/

# MCP local config has machine-specific absolute paths — copy from local.yaml.example
mcp/config/local.yaml

# Go toolchain tarballs should never be committed
go*.linux-amd64.tar.gz
go*.darwin-amd64.tar.gz
go*.windows-amd64.zip

# PORTAL-001 scripts/services-restart-check.sh default output
services-restart-results.md

# NGAP ASN.1 modules: extracted locally by scripts/extract-asn1.sh, never committed (REL19 plan R3 fallback)
specs/asn1/

# PacketRusher image: build-time copy of shared codecs (scripts/packetrusher-vendor.sh)
docker/packetrusher/claudia-vendor/
